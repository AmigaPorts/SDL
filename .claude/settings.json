{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git *)",
      "Bash(make *)",
      "Bash(docker run *)",
      "Bash(vamos *)",
      "Bash(chmod +x *)",
      "Bash(python *)",
      "WebSearch",
      "WebFetch(domain:amigadev.elowar.com)",
      "WebFetch(domain:archive.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:wiki.libsdl.org)",
      "WebFetch(domain:www.libsdl.org)",
      "WebFetch(domain:aminet.net)",
      "WebFetch(domain:wiki.amigaos.net)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/enforce-adcd-lookup.sh",
            "statusMessage": "Checking ADCD requirements..."
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/check-ascii-source.sh",
            "statusMessage": "Checking for non-ASCII in C source..."
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/enforce-plan-before-code.sh",
            "statusMessage": "Checking KB plan..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/check-toolchain.sh",
            "timeout": 15,
            "statusMessage": "Checking toolchain..."
          }
        ]
      }
    ]
  },
  "autoMode": {
    "allow": [
      "Building SDL2 library via make",
      "Reading any file in the project",
      "Running vamos for smoke tests",
      "Running docker for cross-compilation"
    ],
    "soft_deny": [
      "Pushing to remote repositories",
      "Deleting source directories",
      "Modifying files outside the project"
    ],
    "environment": [
      "SDL2 platform library for AmigaOS 3.x on 68k",
      "Cross-compilation via Docker (bebbo-gcc)",
      "Testing via FS-UAE with RTG enabled"
    ]
  }
}
